{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "super-secret-key-that-must-be-very-long-and-secure-for-development",
    "Issuer": "GDriveLight",
    "Audience": "GDriveLightClient",
    "ExpirationInMinutes": 1440
  },
  "Storage": {
    "Provider": "Local",
    "Path": "uploads",
    "DefaultQuotaBytes": 2147483648,
    "MaxFileSizeBytes": 524288000,
    "S3": {
      "BucketName": "<YOUR_S3_BUCKET>",
      "Region": "<YOUR_AWS_REGION>",
      "ServiceUrl": "",
      "ForcePathStyle": false,
      "AccessKey": "<YOUR_ACCESS_KEY>",
      "SecretKey": "<YOUR_SECRET_KEY>",
      "SessionToken": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 525336576
    }
  }
}
