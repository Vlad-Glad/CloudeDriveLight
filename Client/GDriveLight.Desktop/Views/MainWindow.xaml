<Window x:Class="GDriveLight.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:GDriveLight.Desktop.ViewModels"
        xmlns:converters="clr-namespace:GDriveLight.Desktop.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}" Width="1200" Height="780" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="FileTypeFilterMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Height" Value="36" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <ScrollViewer x:Name="TypeOptionsScroller" MaxHeight="180" CanContentScroll="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ProfileAvatarTemplate">
            <Grid Width="40" Height="40">
                <Ellipse Fill="{DynamicResource SidebarSelectedBrush}" />
                <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource SidebarSelectedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse>
                    <Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" /></Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Avatar}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </DataTemplate>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OutlinedActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F0F4F9" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2ECF8" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,12,0,28">
                <ui:SymbolIcon Symbol="Cloud48" Foreground="{DynamicResource PrimaryBrandBrush}" FontSize="30" />
                <TextBlock Text="GDriveLight" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <ui:Button x:Name="NewButton" Grid.Row="1" IsEnabled="{Binding CanManageFiles}" Click="NewButtonClick"
                       Background="White" CornerRadius="16" Padding="20,14"
                       Margin="0,0,0,20" HorizontalAlignment="Left">
                <ui:Button.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.12" /></ui:Button.Effect>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Add24" FontSize="22" />
                    <TextBlock Text="New" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0"
                     IsEnabled="{Binding CanNavigate}"
                     SelectedIndex="{Binding SelectedSidebarIndex, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,12" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="22"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem x:Name="HomeSidebarItem" AllowDrop="True"
                             DragOver="ItemDragOver" Drop="ItemDrop" DragLeave="ItemDragLeave">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Home24" FontSize="20" />
                        <TextBlock Text="Home" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderSync24" FontSize="20" />
                        <TextBlock Text="Synced folders" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Grid>
        <Border Grid.Column="1" Background="White" CornerRadius="20" Margin="0,16,16,16">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,24">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Style="{StaticResource QuietButton}" Command="{Binding RetryCommand}"
                                ToolTip="Refresh" AutomationProperties.Name="Refresh" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="22" />
                        </Button>
                        <Button Style="{StaticResource QuietButton}" Command="{Binding SyncCommand}"
                                ToolTip="Synchronize" AutomationProperties.Name="Synchronize" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="22" />
                        </Button>
                        <TextBlock Text="{Binding SyncStatusSummary}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Style="{StaticResource QuietButton}" Click="AccountSettingsClick" ToolTip="Account settings"
                                AutomationProperties.Name="Account settings" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="22" />
                        </Button>
                        <Button x:Name="AvatarButton" Style="{StaticResource QuietButton}" Padding="3"
                                ToolTip="User profile" AutomationProperties.Name="User profile" Click="ProfileButtonClick">
                            <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource ProfileAvatarTemplate}"
                                            IsHitTestVisible="False" Focusable="False" />
                        </Button>
                        <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=AvatarButton}"
                               Placement="Bottom" HorizontalOffset="-266" VerticalOffset="8"
                               StaysOpen="True" AllowsTransparency="True"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               Opened="ProfilePopupOpened">
                            <Border x:Name="ProfileCard" Width="312" Padding="20" CornerRadius="16"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" Focusable="True" FocusVisualStyle="{x:Null}"
                                    KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ProfileCardKeyDown"
                                    AutomationProperties.Name="User profile">
                                <StackPanel>
                                    <Viewbox Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource ProfileAvatarTemplate}"
                                                        Focusable="False" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Profile.FirstName}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Profile.Email}" Margin="0,6,0,0" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,10" />
                                    <Button x:Name="ProfileLogoutButton" Command="{Binding LogoutCommand}"
                                            Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Log out">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="SignOut24" FontSize="18" />
                                            <TextBlock Text="Log out" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding BreadcrumbTrail}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.NavigateBackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="0,6"
                                                AllowDrop="True" DragOver="ItemDragOver" Drop="ItemDrop" DragLeave="ItemDragLeave">
                                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" />
                                        </Button>
                                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" Margin="8,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CurrentFolderName}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12"
                        Margin="0,0,0,14" Visibility="{Binding IsSyncedFoldersView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Device" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="DeviceSelector" ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CanNavigate}" MinWidth="160" MaxWidth="220"
                                      VerticalAlignment="Center" AutomationProperties.Name="Viewed device" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="Local folder" FontWeight="Medium"
                                   VerticalAlignment="Center" Margin="16,0,8,0" />

                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Height="34" Padding="10,0" VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Folder24" FontSize="16" Foreground="{DynamicResource FolderIconBrush}"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentSyncFolderPath}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentSyncFolderPath}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentSyncFolderPath}" Value="">
                                                    <Setter Property="Text" Value="No folder configured" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CurrentSyncFolderPath}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="No folder configured" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ChangeSyncFolderCommand}"
                                    Style="{StaticResource OutlinedActionButtonStyle}"
                                    ToolTip="Change local sync folder"
                                    AutomationProperties.Name="Change local sync folder"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Change..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenSyncFolderInExplorerCommand}"
                                    Style="{StaticResource OutlinedActionButtonStyle}"
                                    ToolTip="Open folder in File Explorer"
                                    AutomationProperties.Name="Open folder in File Explorer">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource SearchBarBackgroundBrush}"
                        CornerRadius="26" Padding="16,12" Margin="0,0,0,20">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Search24" FontSize="20" Margin="0,0,12,0" />
                        <TextBox x:Name="SearchInput" IsEnabled="{Binding CanManageFiles}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="Search files and folders">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" />
                                        <TextBlock x:Name="Placeholder" Text="Search files and folders" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Row="3">
                    <!-- Operation progress bar -->
                    <Border Visibility="{Binding IsOperating, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelOperationCommand}"
                                    Style="{StaticResource QuietButton}" Padding="10,4" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding OperationStatus}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Notification banner -->
                    <Border Margin="0,0,0,10" CornerRadius="10" ClipToBounds="True"
                            Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EBF5FB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotificationError}" Value="True">
                                        <Setter Property="Background" Value="#FDECEA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Colored accent bar -->
                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNotificationError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PdfIconBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <DockPanel Grid.Column="1" Margin="12,10">
                                <Button DockPanel.Dock="Right" Command="{Binding DismissNotificationCommand}"
                                        Style="{StaticResource QuietButton}" Padding="4"
                                        AutomationProperties.Name="Dismiss notification">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                                </Button>
                                <TextBlock Text="{Binding NotificationMessage}" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#0A3D5E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNotificationError}" Value="True">
                                                    <Setter Property="Foreground" Value="#8B1A10" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="FileTypeFilterButton" Content="{Binding FileTypeFilterLabel}" Click="FileTypeFilterButtonClick"
                            HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,6"
                            Style="{StaticResource QuietButton}" Foreground="{DynamicResource TextSecondaryBrush}"
                            IsEnabled="{Binding CanManageFiles}"
                            ToolTip="Filter by file type" AutomationProperties.Name="Filter by file type" />
                    <Button x:Name="ColumnsButton" Content="Columns ▾" Click="ColumnsButtonClick"
                            HorizontalAlignment="Right" Margin="0,0,0,6" Padding="10,6"
                            Style="{StaticResource QuietButton}" Foreground="{DynamicResource TextSecondaryBrush}"
                            ToolTip="Show or hide columns" AutomationProperties.Name="Show or hide columns" />
                    <Grid x:Name="FileDropSurface" Grid.Row="1" Background="Transparent" AllowDrop="True"
                          PreviewDragOver="ItemDragOver" PreviewDrop="ItemDrop" PreviewDragLeave="ItemDragLeave">
                        <DataGrid x:Name="FileGrid" ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding SelectedFile}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeRows="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  RowHeight="56" BorderThickness="0" Background="{DynamicResource SurfaceBrush}"
                                  AllowDrop="True" PreviewMouseLeftButtonDown="FileGridMouseDown" PreviewMouseLeftButtonUp="FileGridMouseUp"
                                  PreviewMouseMove="FileGridMouseMove"
                                  PreviewMouseRightButtonUp="FileGridRightClick" PreviewKeyDown="FileGridKeyDown"
                                  MouseDoubleClick="FileGridDoubleClick"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedFile}" />
                                <KeyBinding Key="F2" Command="{Binding RenameCommand}" CommandParameter="{Binding SelectedFile}" />
                                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedFile}" />
                                <KeyBinding Key="M" Modifiers="Control" Command="{Binding MoveCommand}" CommandParameter="{Binding SelectedFile}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="NameColumn" Header="Name" Width="*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="24" Margin="0,0,14,0"
                                                               Foreground="{Binding IconColorBrushKey, Converter={StaticResource StringToBrushConverter}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Type" Width="90" Binding="{Binding FileType}" />
                                <DataGridTemplateColumn Header="Created" Width="155" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding CreatedTimestamp}">
                                                <TextBlock Text="{Binding DateCreated}" FontSize="13" />
                                                <TextBlock Text="{Binding TimeCreated}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Modified" Width="155" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding ModifiedTimestamp}">
                                                <TextBlock Text="{Binding DateModified}" FontSize="13" />
                                                <TextBlock Text="{Binding TimeModified}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Size" Width="90" Binding="{Binding Size}" />
                                <DataGridTemplateColumn x:Name="ActionsColumn" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource QuietButton}" Click="RowActionsClick"
                                                    Width="32" Height="32" Padding="4" ToolTip="File actions" AutomationProperties.Name="File actions">
                                                <ui:SymbolIcon Symbol="MoreVertical24" FontSize="20" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="56" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyDescription}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       MaxWidth="380" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="48" Foreground="{DynamicResource PdfIconBrush}" Margin="0,0,0,16" />
                            <TextBlock Text="Could not load this folder" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       MaxWidth="380" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="Retry" Command="{Binding RetryCommand}" Margin="0,20,0,0" HorizontalAlignment="Center" Padding="24,8" />
                        </StackPanel>
                        <Border x:Name="DropUploadBanner" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" Padding="14,8" CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <TextBlock x:Name="DropUploadHint" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
