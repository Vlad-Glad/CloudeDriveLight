<Window x:Class="GDriveLight.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:GDriveLight.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:LoginViewModel, IsDesignTimeCreatable=False}"
        Title="GDriveLight" Width="1200" Height="780" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#9AA0A6" />
        <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FCE8E6" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="700">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Width="880"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.06" Color="#263E60" />
                    </Border.Effect>
                    <Grid Margin="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Intro & Info -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Brand Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,48">
                                <ui:SymbolIcon Symbol="Cloud48" FontSize="32" Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="GDriveLight" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Welcome Title & Subtitle -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                <TextBlock FontSize="30" FontWeight="Medium" LineHeight="38" TextWrapping="Wrap" Margin="0,0,0,16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Ласкаво просимо до GDriveLight" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                                    <Setter Property="Text" Value="Створіть свій обліковий запис" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" LineHeight="22" TextWrapping="Wrap">
                                    <Run Text="Ваші файли. Ваш простір." />
                                    <LineBreak />
                                    <Run Text="Усе необхідне, де б ви не були." />
                                </TextBlock>
                            </StackPanel>

                            <!-- Storage Note (Bottom) -->
                            <Border Grid.Row="2" Background="{DynamicResource SearchBarBackgroundBrush}"
                                    CornerRadius="12" Padding="12,10" HorizontalAlignment="Left" Margin="0,32,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Cloud24" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Включено: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="2 GB " FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="хмарного простору " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="TRIAL" Foreground="White" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Right Column: Auth Form -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
                            <!-- Form Heading -->
                            <TextBlock FontSize="20" FontWeight="Medium" Margin="0,0,0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Увійти" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                                <Setter Property="Text" Value="Почати роботу" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Email -->
                            <TextBlock Text="Електронна адреса" FontSize="13.5" FontWeight="Medium" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Email address"
                                     Margin="0,0,0,16" />

                            <!-- First Name (Register only) -->
                            <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Ім'я" FontSize="13.5" FontWeight="Medium" Margin="0,0,0,8" />
                                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="First name"
                                         Margin="0,0,0,16" />
                            </StackPanel>

                            <!-- Password -->
                            <TextBlock Text="Пароль" FontSize="13.5" FontWeight="Medium" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <PasswordBox x:Name="PasswordInput"
                                             PasswordChanged="PasswordChanged"
                                             Padding="12,0,36,0"
                                             AutomationProperties.Name="Password" />
                                <TextBox x:Name="PasswordRevealInput"
                                         TextChanged="PasswordRevealChanged"
                                         Visibility="Collapsed"
                                         Padding="12,0,36,0"
                                         AutomationProperties.Name="Password" />
                                <Button x:Name="TogglePasswordButton"
                                        Click="TogglePasswordClick"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="8,6"
                                        Margin="0,0,4,0"
                                        Cursor="Hand"
                                        ToolTip="Показати/приховати пароль"
                                        Focusable="False">
                                    <ui:SymbolIcon x:Name="TogglePasswordIcon"
                                                   Symbol="Eye24"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- Error Message -->
                            <Border Background="{StaticResource ErrorBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrorTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           LineHeight="18" />
                            </Border>

                            <!-- Primary Button -->
                            <Button Command="{Binding SubmitCommand}"
                                    IsDefault="True"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    Height="44"
                                    HorizontalAlignment="Stretch"
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Cursor="Hand"
                                    AutomationProperties.Name="Submit">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#0842A0" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="Увійти" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                                <Setter Property="Content" Value="Створити акаунт" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Content" Value="Зачекайте..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Mode Switch Link -->
                            <Button Command="{Binding ToggleModeCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Padding="8,4"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="Створити акаунт" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontSize" Value="13.5" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                                <Setter Property="Content" Value="Вже маєте акаунт? Увійти" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
