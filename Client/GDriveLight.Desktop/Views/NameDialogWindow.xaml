<Window x:Class="GDriveLight.Desktop.Views.NameDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}" FontFamily="{DynamicResource AppFontFamily}">
    <Border Background="White" CornerRadius="16" Margin="16" Padding="24">
        <StackPanel>
            <TextBlock x:Name="PromptLabel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBox x:Name="NameInput" MaxLength="255" Padding="12,8" AutomationProperties.Name="Name" />
            <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{DynamicResource PdfIconBrush}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Padding="20,8" Margin="0,0,8,0" />
                <Button Content="Save" IsDefault="True" Click="SaveClick" Padding="20,8"
                        Background="{DynamicResource AccentBrush}" Foreground="White" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
