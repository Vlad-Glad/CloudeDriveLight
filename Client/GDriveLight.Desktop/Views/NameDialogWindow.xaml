<Window x:Class="GDriveLight.Desktop.Views.NameDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}" FontFamily="{DynamicResource AppFontFamily}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#1E3A8A" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="PromptLabel" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBox x:Name="NameInput" MaxLength="255" Padding="12,8" Height="40" VerticalContentAlignment="Center" AutomationProperties.Name="Name" />
            <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="{DynamicResource PdfIconBrush}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{DynamicResource OutlinedActionButtonStyle}" Height="36" Padding="20,8" Margin="0,0,8,0" />
                <Button Content="Save" IsDefault="True" Click="SaveClick" Style="{DynamicResource PrimaryActionButtonStyle}" Height="36" Padding="20,8" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
