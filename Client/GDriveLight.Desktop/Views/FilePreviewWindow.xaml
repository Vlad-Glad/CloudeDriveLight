<Window x:Class="GDriveLight.Desktop.Views.FilePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1000" Height="720" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="WindowPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding CurrentFile.Name}" FontSize="18" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFile.Name}" />
                <TextBlock Text="{Binding PositionText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Previous" Command="{Binding PreviousCommand}" ToolTip="Previous file (Alt+Left)" />
                <Button Content="Next" Command="{Binding NextCommand}" ToolTip="Next file (Alt+Right)" />
                <Button Content="Download" Command="{Binding DownloadCommand}" />
                <Button Content="Close" Click="CloseClick" ToolTip="Close (Esc)" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                    <TextBlock Text="Loading preview…" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
                <Grid Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8">
                        <Button Content="−" Command="{Binding ZoomOutCommand}" AutomationProperties.Name="Zoom out" />
                        <TextBlock Text="{Binding ZoomText}" MinWidth="90" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="+" Command="{Binding ZoomInCommand}" AutomationProperties.Name="Zoom in" />
                        <Button Content="Fit" Command="{Binding FitCommand}" ToolTip="Fit image to window" />
                    </StackPanel>
                    <ScrollViewer x:Name="ImageScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Viewbox Width="{Binding ViewportWidth, ElementName=ImageScroller}"
                                 Height="{Binding ViewportHeight, ElementName=ImageScroller}" Stretch="Uniform">
                            <Viewbox.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            </Viewbox.LayoutTransform>
                            <Image x:Name="PreviewImage" Source="{Binding Image}" Stretch="Uniform"
                                   AutomationProperties.Name="{Binding CurrentFile.Name}" />
                        </Viewbox>
                    </ScrollViewer>
                </Grid>
                <TextBox x:Name="PreviewText" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" FontSize="14" TextWrapping="NoWrap" Padding="16" BorderThickness="0"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                         AutomationProperties.Name="Text preview"
                         Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel MaxWidth="450" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="Retry" Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Image previews may be scaled down. GIF/TIFF previews show the first frame." FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="Read-only text preview. Select and copy text with Ctrl+C." FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding DownloadStatus}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
